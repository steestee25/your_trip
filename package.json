{
  "name": "universal-trip-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Visual multi-destination trip planner built on free and open data (OpenStreetMap, Nominatim, Overpass, Wikidata, Wikipedia, OSRM).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node tests/logic.test.mjs && node tests/e2e.test.mjs",
    "test:logic": "node tests/logic.test.mjs",
    "test:e2e": "node tests/e2e.test.mjs",
    "typecheck": "tsc -b --force"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.0"
  }
}
